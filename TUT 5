import java.util.Scanner;

// ----- Custom Exceptions -----

class BookNotFoundException extends Exception {
    BookNotFoundException(String msg) {
        super(msg);
    }
}

class BookAlreadyCheckedOutException extends Exception {
    BookAlreadyCheckedOutException(String msg) {
        super(msg);
    }
}

class InvalidReturnDateException extends Exception {
    InvalidReturnDateException(String msg) {
        super(msg);
    }
}

// ----- Book Class -----

class Book {
    String title;
    boolean issued;

    Book(String title) {
        this.title = title;
        this.issued = false;
    }
}

// ----- Library Class -----

class Library {

    Book[] books = new Book[5];
    int total = 0;

    void addBook(Book b) {
        if (total < books.length) {
            books[total] = b;
            total++;
        } else {
            System.out.println("Library is full, can't add more books.");
        }
    }

    void issueBook(String name)
            throws BookNotFoundException, BookAlreadyCheckedOutException {

        Book b = null;

        for (int i = 0; i < total; i++) {
            if (books[i].title.equalsIgnoreCase(name)) {
                b = books[i];
                break;
            }
        }

        if (b == null) {
            throw new BookNotFoundException("Book not found: " + name);
        }

        if (b.issued) {
            throw new BookAlreadyCheckedOutException("Book already issued!");
        }

        b.issued = true;
        System.out.println("Book issued: " + b.title);
    }

    void returnBook(String name, int days)
            throws BookNotFoundException, InvalidReturnDateException {

        if (days < 0) {
            throw new InvalidReturnDateException("Invalid days entered.");
        }

        Book b = null;

        for (int i = 0; i < total; i++) {
            if (books[i].title.equalsIgnoreCase(name)) {
                b = books[i];
                break;
            }
        }

        if (b == null) {
            throw new BookNotFoundException("Book not found: " + name);
        }

        if (!b.issued) {
            System.out.println("This book wasn't issued.");
            return;
        }

        b.issued = false;
        System.out.println("Book returned: " + b.title);

        if (days > 0) {
            int fine = days * 10;
            System.out.println("Fine = ₹" + fine);
        }
    }
}

// ----- Main Class -----

public class LibBook {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        Library lib = new Library();

        // adding some books
        lib.addBook(new Book("Java Programming"));
        lib.addBook(new Book("Python Basics"));
        lib.addBook(new Book("Data Structures"));

        int choice;

        do {
            System.out.println("\n--- MENU ---");
            System.out.println("1. Issue Book");
            System.out.println("2. Return Book");
            System.out.println("3. Exit");
            System.out.print("Enter choice: ");

            choice = sc.nextInt();
            sc.nextLine(); // consume newline

            try {

                if (choice == 1) {
                    System.out.print("Enter book name: ");
                    String name = sc.nextLine();
                    lib.issueBook(name);

                } else if (choice == 2) {
                    System.out.print("Enter book name: ");
                    String name = sc.nextLine();

                    System.out.print("Days late: ");
                    int d = sc.nextInt();

                    lib.returnBook(name, d);

                } else if (choice == 3) {
                    System.out.println("Bye!");
                } else {
                    System.out.println("Wrong choice.");
                }

            } catch (Exception e) {
                System.out.println("Error: " + e.getMessage());
            }

        } while (choice != 3);

        sc.close();
    }
}

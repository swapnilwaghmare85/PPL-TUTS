}

// Main Class
public class RentalApplication {

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        int option;
        String modelName;
        double pricePerDay;
        int totalDays;

        System.out.println("******** VEHICLE RENTAL MENU ********");
        System.out.println("1 -> Car");
        System.out.println("2 -> Bike");
        System.out.println("3 -> Truck");
        System.out.print("Enter your choice: ");

        option = input.nextInt();
        input.nextLine();

        switch (option) {

            case 1:
                System.out.print("Enter car model: ");
                modelName = input.nextLine();

                System.out.print("Enter daily rent: ");
                pricePerDay = input.nextDouble();
                input.nextLine();

                CarRental carObj = new CarRental(modelName, pricePerDay);

                System.out.print("Enter rental duration (days): ");
                totalDays = input.nextInt();
                input.nextLine();

                carObj.assignDays(totalDays);
                carObj.showDetails();
                System.out.println("Total Amount Payable : " + carObj.computeBill());
                break;

            case 2:
                System.out.print("Enter bike model: ");
                modelName = input.nextLine();

                System.out.print("Enter daily rent: ");
                pricePerDay = input.nextDouble();
                input.nextLine();

                BikeRental bikeObj = new BikeRental(modelName, pricePerDay);

                System.out.print("Enter rental duration (days): ");
                totalDays = input.nextInt();
                input.nextLine();

                bikeObj.assignDays(totalDays);
                bikeObj.showDetails();
                System.out.println("Total Amount Payable : " + bikeObj.computeBill());
                break;

            case 3:
                System.out.print("Enter truck model: ");
                modelName = input.nextLine();

                System.out.print("Enter daily rent: ");
                pricePerDay = input.nextDouble();
                input.nextLine();

                TruckRental truckObj = new TruckRental(modelName, pricePerDay);

                System.out.print("Enter rental duration (days): ");
                totalDays = input.nextInt();
                input.nextLine();

                truckObj.assignDays(totalDays);
                truckObj.showDetails();
                System.out.println("Total Amount Payable : " + truckObj.computeBill());
                break;

            default:
                System.out.println("Invalid selection. Please restart.");
        }

        input.close();
    }
}

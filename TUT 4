import java.util.*;

// Base Class
class VehicleBase {

    String category;
    int rentalDays;
    double basePrice;

    VehicleBase(String category, double basePrice) {
        this.category = category;
        this.basePrice = basePrice;
    }

    protected int computeBill() {
        return (int) basePrice * rentalDays;
    }

    void showDetails() {
        // will be overridden
    }
}

// Car Class
class CarRental extends VehicleBase {

    CarRental(String category, double basePrice) {
        super(category, basePrice);
    }

    public void assignDays(int d) {
        rentalDays = d;
    }

    @Override
    void showDetails() {
        System.out.println("\nVehicle Category : CAR");
        System.out.println("Model Type       : " + category);
        System.out.println("Rate Per Day     : " + basePrice);
        System.out.println("Number of Days   : " + rentalDays);
    }
}

// Bike Class
class BikeRental extends VehicleBase {

    BikeRental(String category, double basePrice) {
        super(category, basePrice);
    }

    public void assignDays(int d) {
        rentalDays = d;
    }

    @Override
    void showDetails() {
        System.out.println("\nVehicle Category : BIKE");
        System.out.println("Model Type       : " + category);
        System.out.println("Rate Per Day     : " + basePrice);
        System.out.println("Number of Days   : " + rentalDays);
    }
}

// Truck Class
class TruckRental extends VehicleBase {

    TruckRental(String category, double basePrice) {
        super(category, basePrice);

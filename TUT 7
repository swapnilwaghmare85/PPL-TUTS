import java.io.*; 
import java.util.ArrayList; 
import java.util.Scanner; 
class Student { 
String name; 
int rno; 
double avg_marks; 
String grade; 
Student(String name, int rno, double avg_marks, String grade) { 
this.name = name; 
this.rno = rno; 
this.avg_marks = avg_marks; 
this.grade = grade; 
} 
public String toString() { 
return name + ", " + rno + ", " + avg_marks + ", " + grade; 
} 
} 
class Record { 
private ArrayList<Student> list = new ArrayList<>(); 
// Add record 
public void addRecord(String name, int rno, double avg_marks, String grade) { 
list.add(new Student(name, rno, avg_marks, grade)); 
System.out.println("Record added: Name: " + name + "| Roll_no: " + rno + "| Avg_marks: " + 
avg_marks + "| Grade: " + grade); 
} 
// View records with simple headers 
public void viewRecord() { 
if (list.isEmpty()) { 
System.out.println("No records available."); 
} else { 
System.out.println("Name | RNo | Avg Marks | Grade"); 
 for (Student s : list) { 
 System.out.println(s.name + "|" + s.rno + "|" + s.avg_marks + "|" + s.grade); 
 } 
 } 
 } 
 // Delete record 
 public void deleteRecord(int index) { 
 if (index < 0 || index >= list.size()) { 
 System.out.println("Invalid index! Cannot delete."); 
 } else { 
 System.out.println("Deleted Record: " + list.remove(index)); 
 } 
 } 
 // Update record 
 public void updateRecord(int index, double avg_marks, String grade) { 
 if (index < 0 || index >= list.size()) { 
 System.out.println("Invalid index! Cannot update."); 
 } else { 
 Student s = list.get(index); 
 s.avg_marks = avg_marks; 
 s.grade = grade; 
 System.out.println("Record updated: " + s); 
 } 
 } 
 // Search record by name 
 public void searchRecord(String name) { 
 boolean found = false; 
 for (Student s : list) { 
 if (s.name.equalsIgnoreCase(name)) { 
 System.out.println("Found: " + s); 
 found = true; 
 } 
 } 
 if (!found) { 
 System.out.println("No record found with the name: " + name); 
 } 
 } 
 // Save records to file 
 public void saveFile(String filename) { 
 try (PrintWriter pw = new PrintWriter(new FileWriter(filename))) { 
 for (Student s : list) { 
 pw.println(s.name + "|" + s.rno + "|" + s.avg_marks + "|" + s.grade); 
 } 
 System.out.println("Records saved to " + filename); 
} catch (IOException e) { 
System.out.print(e.getMessage()); 
} 
} 
// Load records from file 
public void loadFile(String filename) { 
File file = new File(filename); 
if (!file.exists()) { 
System.out.println("Error: File not found."); 
return; 
} 
try (BufferedReader br = new BufferedReader(new FileReader(file))) { 
String line; 
while ((line = br.readLine()) != null) { 
String[] parts = line.split(","); 
if (parts.length == 4) { 
String name = parts[0]; 
int rno = Integer.parseInt(parts[1]); 
double avg_marks = Double.parseDouble(parts[2]); 
String grade = parts[3]; 
list.add(new Student(name, rno, avg_marks, grade)); 
} 
} 
System.out.println("Records loaded successfully from " + filename); 
} catch (IOException e) { 
System.out.println("Error reading file: " + e.getMessage()); 
} catch (NumberFormatException e) { 
System.out.println("Error in file format: " + e.getMessage()); 
} 
} 
} 
